# ─── Database ──────────────────────────────────────────────────────────
# Postgres credentials (used by docker-compose for both `db` and `app`).
POSTGRES_USER=task_tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=task_tracker
# For local dev outside Docker (pnpm dev), point at a reachable Postgres:
DATABASE_URL=postgres://task_tracker:change-me@localhost:5432/task_tracker

# ─── Server ────────────────────────────────────────────────────────────
# Local dev: the Vite proxy expects the API on 3001 (override with
# API_PROXY_TARGET). In production (Dokploy) do NOT set PORT: Traefik
# routes to 3000 inside the container.
PORT=3001
# Public origin of the app, no trailing slash. Used for OAuth callbacks,
# the same-origin check on mutations and links in Discord messages.
# Local dev: http://localhost:5173 · Production: https://your-domain
APP_BASE_URL=http://localhost:5173
# Optional: serve the built web app from this directory (set automatically in Docker).
# WEB_DIST_DIR=../web/dist

# ─── Access ────────────────────────────────────────────────────────────
# Required: comma-separated GitHub logins with the admin role.
# Everyone else is added as a member from Admin → Members.
ADMIN_GITHUB_LOGINS=your-github-login

# ─── GitHub ────────────────────────────────────────────────────────────
# Required: GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# Callback URL: <APP_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required: secret configured on the repository webhook (Pull requests
# events, content type application/json); verifies X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=change-me

# ─── Discord (all optional) ────────────────────────────────────────────
# Notifications: bot token (Developer Portal → Bot). Unset = no messages.
DISCORD_BOT_TOKEN=
# Account linking: set both or neither (OAuth2 → Client ID / Client Secret).
# Redirect: <APP_BASE_URL>/auth/discord/callback
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
# Slash commands: Public Key from General Information (64 hex chars).
# Interactions Endpoint URL: <APP_BASE_URL>/discord/interactions
DISCORD_PUBLIC_KEY=
# Only for `node dist/discord-register.js`: register commands in one
# server (instant) instead of globally.
# DISCORD_GUILD_ID=
